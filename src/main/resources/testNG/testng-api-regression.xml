<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="API Regression Suite"
       parallel="methods"
       thread-count="3">

    <listeners>
        <listener class-name="framework.listeners.TestListener"/>
    </listeners>

    <test name="API Regression Tests">

        <groups>
            <run>
                <include name="regression"/>
                <include name="api"/>
            </run>
        </groups>

        <packages>
            <package name="tests.api"/>
        </packages>

    </test>

</suite>