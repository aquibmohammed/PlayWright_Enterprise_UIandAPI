<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="Parallel-suite" parallel="false" thread-count="3">
    <listeners>
        <listener class-name="com.pm.framework.core.retry.RetryListener"/>
    </listeners>
    <test name="UI tests">
        <classes>
            <class name="tests.ui.HomePageTest"></class>
            <class name="tests.ui.LoginTest"></class>
            <class name="tests.ui.ProductsTest"></class>
            <class name="tests.ui.CartTest"></class>
            <class name="tests.ui.SearchTest"></class>
        </classes>
    </test>
</suite>