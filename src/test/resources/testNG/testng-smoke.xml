<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Suite"
       parallel="methods"
       thread-count="3">

    <listeners>
        <listener class-name="com.pm.framework.Listener.TestListener"/>
    </listeners>

    <test name="Smoke Tests">

        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <packages>
            <package name="tests.ui"/>
            <package name="tests.api"/>
        </packages>

    </test>

</suite>