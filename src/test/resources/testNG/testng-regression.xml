<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" parallel="methods" thread-count="3" >
    <listeners>
        <listener class-name="com.pm.framework.Listener.TestListener"/>
    </listeners>
    <groups>
        <run>
            <include name="regression"></include>
        </run>
    </groups>
    <packages>
        <package name="tests.ui"></package>
    </packages>
</suite>